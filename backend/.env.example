APP_ENV=development
HTTP_ADDR=:8090
FRONTEND_URL=http://localhost:3100
DATABASE_URL=postgresql://USER@localhost:5432/sistem_anggota?sslmode=disable

# Isi dari secret manager; jangan commit nilai nyata.
SSO_ISSUER=https://api.pelajarnumagetan.id
SSO_CLIENT_ID=isi_client_id_sistem_anggota
SSO_CLIENT_SECRET=isi_client_secret_sistem_anggota
SSO_REDIRECT_URL=http://localhost:3100/api/auth/oauth2/callback/ipnu-sso
SESSION_COOKIE_NAME=anggota_session
SESSION_COOKIE_SECURE=false
SESSION_TTL=24h
HTTP_CLIENT_TIMEOUT=10s
# Buat dengan: openssl rand -base64 32
ENCRYPTION_KEY=isi_base64_key_32_byte

LACI_API_URL=http://localhost:8080/api/v1
LACI_API_KEY=isi_api_key_laci
LACI_WEBHOOK_SECRET=isi_webhook_secret
